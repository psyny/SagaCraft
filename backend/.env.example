# Copy to backend/.env for running the API outside Docker. Docker Compose sets these itself.
APP_ENV=development
DATABASE_URL=postgresql://sagacraft:sagacraft@localhost:5432/sagacraft
CORS_ORIGINS=http://localhost:3000

# Signs login tokens, file URLs and the discrete-threshold seeds. Long random string in production.
JWT_SECRET_KEY=dev-secret-change-me-in-production-0123456789
TOKEN_HOURS=336
FILE_URL_MINUTES=120

# Root system admin, created on startup when the instance has none.
ROOT_ADMIN_LOGIN=admin
ROOT_ADMIN_PASSWORD=admin123

MAX_UPLOAD_MB=5
RUN_MIGRATIONS_ON_STARTUP=true
