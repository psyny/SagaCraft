FROM python:3.12-slim

WORKDIR /app

# postgresql-client for pg_isready (the entrypoint waits for the database)
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY sagacraft ./sagacraft
COPY scripts ./scripts
COPY docker ./docker
RUN pip install --no-cache-dir -e . && sed -i 's/\r$//' /app/docker/api-entrypoint.sh && chmod +x /app/docker/api-entrypoint.sh

ENV PYTHONPATH=/app/sagacraft
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

ENTRYPOINT ["/app/docker/api-entrypoint.sh"]
# Railway sets PORT
CMD sh -c "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"
